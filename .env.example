# Local analytics work without an AI key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
# Production mode always requires OIDC. For local OIDC testing:
REQUIRE_AUTH=false
# Comma-separated subject IDs from your configured OIDC provider.
ALLOWED_SUBJECTS=
